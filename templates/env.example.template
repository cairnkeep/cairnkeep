# Cairnkeep repo-local environment. Copy to .ai/.env and edit.
#
# The memory server uses an OpenAI-compatible endpoint for memory extraction and
# embedding-ranked search. Leave these unset to run memory in substring-only mode.
#
# CAIRN_LLM_API_KEY=
# CAIRN_LLM_API_URL=https://api.openai.com/v1
# CAIRN_LLM_EXTRACTION_MODEL=gpt-4o-mini
# CAIRN_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# CAIRN_MEMORY_EMBEDDING_TIMEOUT_MS=15000
#
# Git host for the collaboration commands (memory-sync, repo-review, security-audit).
# One of: github | gitlab | codeberg | forgejo | none.  See docs/git-providers.md.
# CAIRN_GIT_PROVIDER=github
#
# Storage belongs to the host running the memory-server process. Named/global
# scopes default to ~/.cairnkeep; project scope uses <server-cwd>/.agentfs/.
# CAIRN_AGENTFS_BASE_DIR=~/.cairnkeep
#
# Least-authority MCP profiles only restrict currently available tools. Project
# state is managed with `cairn mcp-tools`; these are process overrides.
# CAIRN_MCP_TOOL_PROFILE=read-only
# CAIRN_MCP_ALLOWED_TOOLS=memory_read,memory_search
#
# Immutable context packs are local and OFF by default. HTTP access requires
# the separate pack HTTP flag plus the existing authenticated HTTP settings.
# CAIRN_CONTEXT_PACKS=1
# CAIRN_CONTEXT_PACK_HTTP=1
# CAIRN_PACK_BASE_DIR=~/.cairnkeep/packs
#
# Typed metadata, filters, logical note address spaces, and memory_import are
# OFF by default. Restart the memory server after changing this construction-
# time tool-schema flag. No model, API key, or network endpoint is required.
# CAIRN_TYPED_MEMORY_NODES=1
#
# The managed capability contract is OFF by default. Project state is managed
# with `cairn capabilities`; these environment variables are optional strict
# per-process overrides. Strict booleans: 1 | true | yes | on; 0 | false | no | off.
# Leave every key below unset unless the current process needs an explicit
# override. MCP capability changes require a memory-server restart.
# CAIRN_CAPABILITY_CONTRACT=
# CAIRN_CAPABILITY_LOGGING=
# CAIRN_CAPABILITY_MEMORY_WRITE=
# CAIRN_CAPABILITY_MEMORY_SEARCH=
# CAIRN_CAPABILITY_NOTES_DISTILL=
# CAIRN_CAPABILITY_WIKI=
# CAIRN_CAPABILITY_GRAPH=
# CAIRN_CAPABILITY_SECURITY_AUDIT=
# CAIRN_CAPABILITY_ROUTE_CHECK=
# CAIRN_CAPABILITY_CONTEXT_EXPLORE=
#
# CAIRN_NOTE_DISTILLATION remains a compatibility input for the existing
# offline note job; enabling the master contract does not enable notes or graph.
# CAIRN_NOTE_DISTILLATION=
# Callback logging also requires the master contract and local capture consent:
# CAIRN_TRAJECTORY_CAPTURE is separate required consent and remains OFF by default.
#
# Structured session trajectories are local and OFF by default. When enabled,
# Claude Code SessionEnd and OpenCode session-idle capture redacted events in
# <project>/.agentfs/trajectory.db. See docs/privacy-and-data-flow.md first.
# CAIRN_TRAJECTORY_CAPTURE=1
# CAIRN_TRAJECTORY_SESSION_MAX_BYTES=5242880
# CAIRN_TRAJECTORY_STORE_MAX_BYTES=268435456
# CAIRN_TRAJECTORY_RETENTION_DAYS=30
# Bootstrap creates .ai/trajectory-redaction.json for optional custom patterns.
# CAIRN_TRAJECTORY_REDACTION_FILE=.ai/trajectory-redaction.json
#
# Harness-produced compaction continuity and explicit artifact access are local
# and OFF by default. Either capability may be enabled independently; neither
# needs a model, API key, or network endpoint. HTTP artifact tools require the
# separate HTTP flag in addition to the existing authenticated HTTP settings.
# CAIRN_COMPACTION_CAPTURE=1
# CAIRN_ARTIFACT_STORE=1
# CAIRN_ARTIFACT_HTTP=1
# CAIRN_ARTIFACT_MAX_BYTES=1048576
# CAIRN_ARTIFACT_SESSION_MAX_BYTES=16777216
# CAIRN_ARTIFACT_STORE_MAX_BYTES=268435456
# CAIRN_ARTIFACT_RETENTION_DAYS=30
# CAIRN_COMPACTION_MAX_REVISIONS=8
# CAIRN_ARTIFACT_GENERATED_FILE_SNAPSHOT_MAX_BYTES=262144
#
# The memory server runs locally over stdio by default. These HTTP settings are
# for the SERVER host of an explicit remote deployment, not a normal local
# client. Setting MCP_HTTP_PORT REQUIRES a bearer token, or startup fails.
# CAIRN_MEMORY_HTTP_TOKEN=change-me-to-a-long-random-secret
# MCP_HTTP_PORT=7801
# MCP_HTTP_HOST=127.0.0.1
# Optional: comma-separated browser origins allowed via CORS (default: none).
# CAIRN_MEMORY_HTTP_ALLOWED_ORIGINS=
# Optional: comma-separated allowed Host headers for DNS-rebinding protection
# (default: the bind host + localhost on the chosen port).
# CAIRN_MEMORY_HTTP_ALLOWED_HOSTS=
#
# Optional document-RAG sync. API credentials and endpoint may be local or remote.
# ANYTHINGLLM_BASE_URL=http://localhost:3001
# ANYTHINGLLM_API_KEY=
# CAIRN_ANYTHINGLLM_PROJECTS_FILE=~/.config/cairnkeep/anythingllm-projects.json
# CAIRN_ANYTHINGLLM_STATE_FILE=~/.local/state/cairnkeep/anythingllm-sync.json
