{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cairnkeep/cairnkeep/main/schemas/eval-task-set.schema.json",
  "title": "Cairnkeep evaluation task set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "source", "tasks"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/identifier" },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/gitSource" },
        { "$ref": "#/$defs/bundledFakeSource" }
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)(?!.*[\\u0000-\\u001f\\u007f])(?!.*\\/$).+$"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "args"],
      "properties": {
        "program": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000\\r\\n]+$" },
        "args": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "maxLength": 16384, "pattern": "^[^\\u0000]*$" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsed_ms", "stdout_bytes"],
      "properties": {
        "elapsed_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "stdout_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    },
    "gitSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "revision"],
      "properties": {
        "kind": { "const": "git" },
        "repository": { "$ref": "#/$defs/relativePath" },
        "revision": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" }
      }
    },
    "bundledFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "content": { "type": "string", "maxLength": 262144 }
      }
    },
    "bundledFakeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifier", "files"],
      "properties": {
        "kind": { "const": "bundled_fake" },
        "identifier": { "const": "cairn-offline-fake-v1" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/bundledFile" }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input", "workspace", "prepare", "verify", "limits"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "input": { "type": "string", "maxLength": 1048576 },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": { "path": { "$ref": "#/$defs/relativePath" } }
        },
        "prepare": { "$ref": "#/$defs/command" },
        "verify": { "$ref": "#/$defs/command" },
        "limits": { "$ref": "#/$defs/limits" }
      }
    }
  }
}
