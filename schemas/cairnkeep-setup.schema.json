{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cairnkeep/cairnkeep/main/schemas/cairnkeep-setup.schema.json",
  "title": "Cairnkeep project setup state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cairnkeep_version", "git", "memory", "harnesses", "assets"],
  "properties": {
    "schema_version": {"const": 1},
    "cairnkeep_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "git": {"enum": ["init", "existing", "none"]},
    "memory": {"enum": ["local", "none"]},
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["claude", "opencode", "pi", "kimi", "qwen", "codex"]}
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^\\.(?:ai|planning|agentfs|codex)/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest", "mode", "template"],
        "properties": {
          "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "mode": {"type": "integer", "minimum": 0, "maximum": 511},
          "template": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
        }
      }
    }
  }
}
