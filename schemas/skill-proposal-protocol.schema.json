{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cairnkeep/cairnkeep/main/schemas/skill-proposal-protocol.schema.json",
  "title": "Cairnkeep skill proposal adapter protocol v1",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/response" }],
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*//)(?!.*[\\u0000-\\u001f\\u007f])(?:.*\\/)?SKILL\\.md$"
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "session_digest", "ended_at", "outcome", "evidence"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "session_digest": { "$ref": "#/$defs/digest" },
        "ended_at": { "$ref": "#/$defs/timestamp" },
        "outcome": { "enum": ["failure", "resolution", "abandonment"] },
        "tool_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "evidence": { "type": "string", "maxLength": 4096 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "project_id", "status", "note_id", "source_digest", "title", "description", "failure_family", "failure_count", "resolution_count", "occurrences", "lessons", "caveats", "created_at", "reviewed_at"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/identifier" },
        "project_id": { "$ref": "#/$defs/identifier" },
        "status": { "const": "approved" },
        "note_id": { "$ref": "#/$defs/identifier" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "description": { "type": "string", "maxLength": 4096 },
        "failure_family": { "$ref": "#/$defs/identifier" },
        "failure_count": { "type": "integer", "minimum": 2, "maximum": 1024 },
        "resolution_count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "occurrences": { "type": "array", "minItems": 2, "maxItems": 64, "items": { "$ref": "#/$defs/occurrence" } },
        "lessons": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "caveats": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "reviewed_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "anchor", "content", "rationale"],
      "properties": {
        "operation": { "enum": ["add", "replace", "delete"] },
        "anchor": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 16384 }, { "type": "null" }] },
        "content": { "type": "string", "maxLength": 65536 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "candidate", "candidate_digest", "target", "edit_budget"],
      "properties": {
        "schema_version": { "const": 1 },
        "operation": { "const": "propose" },
        "candidate": { "$ref": "#/$defs/candidate" },
        "candidate_digest": { "$ref": "#/$defs/digest" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "baseline_digest", "content"],
          "properties": {
            "path": { "$ref": "#/$defs/relativePath" },
            "baseline_digest": { "$ref": "#/$defs/digest" },
            "content": { "type": "string", "maxLength": 262144 }
          }
        },
        "edit_budget": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status"],
      "properties": {
        "schema_version": { "const": 1 },
        "status": { "enum": ["completed", "adapter_error"] },
        "error_code": { "$ref": "#/$defs/identifier" },
        "edits": { "type": "array", "maxItems": 16, "default": [], "items": { "$ref": "#/$defs/edit" } }
      }
    }
  }
}
