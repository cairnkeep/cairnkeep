{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairnkeep.dev/schemas/retrieval-benchmark.schema.json",
  "title": "Cairnkeep retrieval benchmark suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "description", "packs", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1 },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "title", "enabled", "files"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
          "title": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "kind", "title", "description", "keywords", "content"],
              "properties": {
                "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
                "kind": { "enum": ["document", "skill"] },
                "title": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "keywords": { "type": "array", "items": { "type": "string" } },
                "content": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "query", "relevant", "forbidden", "limit"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "query": { "type": "string", "minLength": 1 },
          "relevant": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "forbidden": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      }
    }
  }
}
